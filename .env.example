# 121XML Deployment Configuration
# Copy to .env (never committed). No passwords here: deployment uses an SSH key file.

# SSH Connection Details
XML_SSH_HOST=172.241.29.6
XML_SSH_PORT=19199
XML_SSH_USER=xml
# Full path on this PC to the PRIVATE key whose .pub RK authorised in cPanel > SSH Access
XML_SSH_KEY=C:\Users\Owner\.ssh\121connect_deploy

# Staging Environment
XML_STAGING_PATH=/home/xml/staging.121xml.com
XML_STAGING_URL=https://staging.121xml.com
# user:password for the staging Directory Privacy lock (optional, used only by the smoke test)
XML_STAGING_AUTH=

# Production Environment
XML_PROD_PATH=/home/xml/public_html
XML_PROD_URL=https://121xml.com
# Must match "Where:" in APPROVALS/v<VERSION>.md exactly
XML_PROD_WHERE=HostArmada public_html 121xml.com
